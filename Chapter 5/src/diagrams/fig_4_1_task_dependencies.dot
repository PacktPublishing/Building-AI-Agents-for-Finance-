// Figure 4.1 — Task Dependency Graph for NVIDIA Research
digraph task_deps {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, penwidth=1.2];
    edge [fontname="Helvetica", fontsize=8, penwidth=1.0];
    nodesep=0.4;
    ranksep=0.8;

    t1 [label="Task 1\nNVDA Metrics",             fillcolor="#4ecdc4", color="#3aaba3"];
    t2 [label="Task 2\nAMD Metrics",              fillcolor="#4ecdc4", color="#3aaba3"];
    t3 [label="Task 3\nINTC Metrics",             fillcolor="#4ecdc4", color="#3aaba3"];
    t4 [label="Task 4\nNVDA Risk\nFactors",       fillcolor="#f5a623", color="#c4841c"];
    t5 [label="Task 5\nMarket News",              fillcolor="#7b68ee", fontcolor=white, color="#5a4bc7"];
    t6 [label="Task 6\nComparative\nAnalysis",    fillcolor="#ff9f43", color="#cc7a2e"];
    t7 [label="Task 7\nSynthesize\nReport",       fillcolor="#4a90d9", fontcolor=white, color="#34699c"];

    t1 -> t6;
    t2 -> t6;
    t3 -> t6;
    t4 -> t7;
    t5 -> t7;
    t6 -> t7;

    // Layout hints
    {rank=same; t1; t2; t3; t4; t5}
    {rank=same; t6}
    {rank=same; t7}

    // Legend
    subgraph cluster_legend {
        label="Parallel execution groups";
        labeljust=l;
        fontsize=9;
        fontname="Helvetica-Oblique";
        style=dashed;
        color="#cccccc";
        margin=8;

        l1 [label="Tasks 1-5: parallel\n(no dependencies)", shape=plaintext, fillcolor=transparent, fontsize=8];
        l2 [label="Task 6: waits for 1,2,3", shape=plaintext, fillcolor=transparent, fontsize=8];
        l3 [label="Task 7: waits for all", shape=plaintext, fillcolor=transparent, fontsize=8];

        l1 -> l2 -> l3 [style=invis];
    }
}
