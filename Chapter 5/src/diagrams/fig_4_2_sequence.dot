// Figure 4.2 — Deep Search Execution Sequence
// Note: Graphviz doesn't natively support sequence diagrams.
// This uses a structured layout to represent the flow.
digraph sequence {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9, style=filled, shape=box, penwidth=1.0];
    edge [fontname="Helvetica", fontsize=8];
    compound=true;
    nodesep=0.3;
    ranksep=0.35;

    // Actors
    user  [label="User",         fillcolor="#4a90d9", fontcolor=white, color="#34699c", shape=box, style="filled,rounded,bold", fontsize=11];
    orch  [label="Orchestrator", fillcolor="#f5a623", color="#c4841c", shape=box, style="filled,rounded,bold", fontsize=11];
    plan  [label="Planner",      fillcolor="#fef3c7", color="#b7950b", shape=box, style="filled,rounded,bold", fontsize=11];
    exec  [label="Executor",     fillcolor="#e8d5f5", color="#8e44ad", shape=box, style="filled,rounded,bold", fontsize=11];
    val   [label="Validator",    fillcolor="#d5f5e3", color="#27ae60", shape=box, style="filled,rounded,bold", fontsize=11];
    synth [label="Synthesizer",  fillcolor="#d5e8f5", color="#2980b9", shape=box, style="filled,rounded,bold", fontsize=11];

    {rank=same; user; orch; plan; exec; val; synth}

    // Phase 1: Planning
    subgraph cluster_phase1 {
        label="Phase 1: Plan";
        fontsize=10;
        fontname="Helvetica-Bold";
        style=rounded;
        color="#b7950b";
        bgcolor="#fffef0";
        margin=8;

        p1 [label="Research question\n→ Planner", shape=plaintext, fillcolor=transparent];
        p2 [label="Returns 7 sub-tasks\nwith dependencies", shape=plaintext, fillcolor=transparent];
        p1 -> p2;
    }

    // Phase 2: Execute (parallel)
    subgraph cluster_phase2 {
        label="Phase 2: Execute (parallel)";
        fontsize=10;
        fontname="Helvetica-Bold";
        style=rounded;
        color="#8e44ad";
        bgcolor="#faf0fc";
        margin=8;

        e1 [label="Task 1: NVDA metrics → Financial API", fillcolor="#4ecdc4", color="#3aaba3"];
        e2 [label="Task 2: AMD metrics → Financial API",  fillcolor="#4ecdc4", color="#3aaba3"];
        e3 [label="Task 3: INTC metrics → Financial API", fillcolor="#4ecdc4", color="#3aaba3"];
        e4 [label="Task 4: Risk factors → SEC EDGAR",     fillcolor="#f5a623", color="#c4841c"];
        e5 [label="Task 5: Market news → Web Search",     fillcolor="#7b68ee", fontcolor=white, color="#5a4bc7"];

        {rank=same; e1; e2; e3; e4; e5}

        e6 [label="Tasks 1-5 complete → Task 6: Comparative analysis", fillcolor="#ff9f43", color="#cc7a2e"];

        e1 -> e6 [style=dashed, color="#999"];
        e2 -> e6 [style=dashed, color="#999"];
        e3 -> e6 [style=dashed, color="#999"];
    }

    // Phase 3: Validate
    subgraph cluster_phase3 {
        label="Phase 3: Validate";
        fontsize=10;
        fontname="Helvetica-Bold";
        style=rounded;
        color="#27ae60";
        bgcolor="#f0faf0";
        margin=8;

        v1 [label="Deterministic checks:\n• All tickers covered ✓\n• Margins in range ✓\n• No contradictions ✓\n• P/E warning (high)", shape=box, fillcolor="#d5f5e3", color="#27ae60"];
    }

    // Phase 4: Synthesize
    subgraph cluster_phase4 {
        label="Phase 4: Synthesize";
        fontsize=10;
        fontname="Helvetica-Bold";
        style=rounded;
        color="#2980b9";
        bgcolor="#f0f7fc";
        margin=8;

        s1 [label="Structured output →\nResearchReport\n(title, summary, metrics,\nanalysis, risks, conclusion)", shape=box, fillcolor="#d5e8f5", color="#2980b9"];
    }

    // Result
    result [label="Investment Memo\nConfidence: 85%", fillcolor="#4a90d9", fontcolor=white, color="#34699c", style="filled,rounded,bold"];

    // Flow
    user -> p1 [lhead=cluster_phase1, label="question"];
    p2 -> e1 [lhead=cluster_phase2, label="plan"];
    e6 -> v1 [lhead=cluster_phase3, label="results"];
    v1 -> s1 [lhead=cluster_phase4, label="valid"];
    s1 -> result [label="report"];
}
